{
  "name": "coffee-order-system",
  "version": "2.0.0",
  "description": "Повнофункціональна система замовлення кави з React frontend та Express backend",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm start",
    "install:all": "npm run install:backend && npm run install:frontend",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "seed": "cd backend && npm run seed",
    "build": "cd frontend && npm run build",
    "test": "concurrently \"npm run test:backend\" \"npm run test:frontend\"",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test -- --watchAll=false",
    "heroku-postbuild": "cd frontend && npm install && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunona46/coffee-order-system.git"
  },
  "keywords": [
    "coffee",
    "order-system",
    "react",
    "express",
    "mongodb",
    "nodejs",
    "jwt",
    "rest-api",
    "full-stack"
  ],
  "author": "Yunona46",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yunona46/coffee-order-system/issues"
  },
  "homepage": "https://github.com/yunona46/coffee-order-system#readme",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "mongoose": "^9.0.1"
  }
}
